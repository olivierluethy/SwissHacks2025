# Copy to .env and fill in. NEVER commit the filled-in file.
# Nothing here is read automatically - export these in your shell or use your
# process manager. Variable names only; no real values belong in this file.

# --- Required ---------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Auth (SEC-002) ---------------------------------------------------------
# When unset the API is completely open. Set it for anything reachable by
# anyone else, and give the same value to the frontend as API_TOKEN.
API_TOKEN=

# --- Models (IMP-005) -------------------------------------------------------
# Compare candidates on your own data with: python -m scripts.benchmark_models
OPENAI_MODEL=o3-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
OPENAI_MAX_COMPLETION_TOKENS=8000
OPENAI_REASONING_EFFORT=medium

# --- Retrieval --------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Must stay under the encoder's 256-token window (BUG-004).
CHUNK_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=8
QUERY_CHUNK_LIMIT=32

# --- Pipeline ---------------------------------------------------------------
MAX_CONCURRENT_LLM_CALLS=6
SUMMARY_SLICE_TOKENS=12000
JOB_STALE_SECONDS=1800

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated. Never "*" - credentials are enabled (SEC-003).
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Serves backend/processed/ with no auth. Leave off unless you need it (SEC-007).
SERVE_RESULTS_STATICALLY=false
